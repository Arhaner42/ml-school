from statistics import median
from timeit import repeat

import numpy as np

def lu(A):
    # return L, U with A = L @ U (no row swaps)
    U = np.array(A, dtype = float)

    n = U.shape[0]
    L = np.eye(n)

    for k in range(n - 1) :
        pivot = U[k, k]
        if pivot == 0 :
            raise Exception("Zero pivot")

        mult = U[(k + 1):, k] / pivot
        L[(k + 1):, k] = mult

        U[(k + 1):, (k + 1):] -= np.outer(mult, U[k, (k + 1):])
        U[(k + 1):, k] = 0

    return L, U

def solve_lu(L, U, b):
    # solve L U x = b by forward and back substitution
    L = np.array(L, dtype = float)
    U = np.array(U, dtype = float)
    b = np.array(b, dtype = float)

    n = b.size
    x = np.empty_like(b)
    y = np.empty_like(b)

    #Forward substitution
    for i in range(n) :
        y[i] = b[i] - L[i, :i] @ y[:i]

    #Backward substitution
    for i in range(n - 1, -1, -1) :
        x[i] = (y[i] - U[i, (i + 1):] @ x[(i + 1):]) / U[i, i]

    return x

def inverseXTX (X) :
    return np.linalg.inv(X.T.dot(X))

def update_inverse(initial_inv, new_rows) :
    XTX_inv = initial_inv
    for row in new_rows :
        z = XTX_inv.dot(row)
        XTX_inv = XTX_inv - np.outer(z, z) / (1 + row.dot(z))

    return XTX_inv
 


